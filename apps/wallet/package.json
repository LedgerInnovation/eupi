{
  "name": "@eupi/wallet",
  "version": "0.0.0",
  "private": true,
  "description": "Reference wallet: render and scan European payment QR codes, then hand off to the payer's own banking app",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LedgerInnovation/eupi.git",
    "directory": "apps/wallet"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform android --output-dir dist",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eupi/qr": "workspace:^",
    "expo": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "^10.0.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.0"
  }
}
